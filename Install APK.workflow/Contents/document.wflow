				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
ADB="$SDK/platform-tools/adb"
AAPT2=$(ls -d "$SDK"/build-tools/*/aapt2 2&gt;/dev/null | sort -V | tail -n 1)
APK="$1"
package=$("$AAPT2" dump packagename "$APK" 2&gt;/dev/null)

# Physical devices first, then emulators. adb calls read /dev/null so they do not eat the loop input.
physical=()
emulators=()
while read -r serial state rest; do
  [ "$state" = "device" ] || continue
  model=$(sed -n 's/.*model:\([^ ]*\).*/\1/p' &lt;&lt;&lt;"$rest" | tr '_' ' ')
  if [[ "$serial" == emulator-* ]]; then
    avd=$("$ADB" -s "$serial" emu avd name &lt;/dev/null 2&gt;/dev/null | head -n 1 | tr -d '\r' | tr '_' ' ')
    emulators+=("Emulator: ${avd:-$model} ($serial)")
  elif [ "$("$ADB" -s "$serial" shell getprop ro.kernel.qemu &lt;/dev/null 2&gt;/dev/null | tr -d '\r')" = "1" ]; then
    emulators+=("Emulator: $model ($serial)")
  else
    physical+=("Device: $model ($serial)")
  fi
done &lt; &lt;("$ADB" devices -l | tail -n +2)
choices=("${physical[@]}" "${emulators[@]}")

if [ ${#choices[@]} -eq 0 ]; then
  echo "Failure: no device connected"
  exit 0
fi

if [ ${#choices[@]} -eq 1 ]; then
  picked="${choices[0]}"
else
  read -r -d '' CHOOSER &lt;&lt;'EOF'
on run argv
  set apkName to item 1 of argv
  set devices to rest of argv
  activate
  set picked to choose from list devices with title "Install APK" with prompt "Install " &amp; apkName &amp; " on:" default items {item 1 of devices} with multiple selections allowed
  if picked is false then return ""
  set AppleScript's text item delimiters to linefeed
  return picked as text
end run
EOF
  picked=$(osascript -e "$CHOOSER" "$(basename "$APK")" "${choices[@]}")
  [ -z "$picked" ] &amp;&amp; exit 0
fi

adb_install() {
  local out
  out=$("$ADB" -s "$1" install -r "$APK" &lt;/dev/null 2&gt;&amp;1)
  grep -i 'fail\|suc' &lt;&lt;&lt;"$out" || tail -n 1 &lt;&lt;&lt;"$out"
}

is_installed() {
  [ -n "$package" ] &amp;&amp; [ -n "$("$ADB" -s "$1" shell pm path "$package" &lt;/dev/null 2&gt;/dev/null)" ]
}

confirm_uninstall() {
  osascript - "$1" "$2" "$package" &gt;/dev/null 2&gt;&amp;1 &lt;&lt;'EOF'
on run argv
  activate
  display dialog "Install failed on " &amp; item 1 of argv &amp; ":" &amp; return &amp; item 2 of argv &amp; return &amp; return &amp; "Uninstall " &amp; item 3 of argv &amp; " and install again? App data will be lost." with title "Install APK" buttons {"Cancel", "Uninstall and Install"} default button "Uninstall and Install" cancel button "Cancel" with icon caution
end run
EOF
}

while IFS= read -r choice; do
  serial=$(sed 's/.*(\(.*\))$/\1/' &lt;&lt;&lt;"$choice")
  name=$(sed 's/^[^:]*: \(.*\) (.*)$/\1/' &lt;&lt;&lt;"$choice")
  result=$(adb_install "$serial")
  if ! grep -q '^Success' &lt;&lt;&lt;"$result" &amp;&amp; is_installed "$serial" &amp;&amp; confirm_uninstall "$name" "$result"; then
    "$ADB" -s "$serial" uninstall "$package" &lt;/dev/null &gt;/dev/null 2&gt;&amp;1
    result=$(adb_install "$serial")
  fi
  awk -v n="$name" '{ print n ": " $0 }' &lt;&lt;&lt;"$result"
  if grep -q '^Success' &lt;&lt;&lt;"$result" &amp;&amp; [ -n "$package" ]; then
    "$ADB" -s "$serial" shell monkey -p "$package" -c android.intent.category.LAUNCHER 1 &lt;/dev/null 2&gt;&amp;1 | grep -q 'Events injected' \
      || echo "$name: could not launch $package"
  fi
done &lt;&lt;&lt;"$picked"
</string>
					<key>CheckedForUserDefaultShell</key>
